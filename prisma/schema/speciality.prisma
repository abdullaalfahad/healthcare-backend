model Speciality {
  id String @id @default(uuid(7))
  title String @unique
  description String?
  icon String?
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted], name: "idx_speciality_is_deleted")
  @@index([title], name: "idx_speciality_title")
  @@map("specialities")
}